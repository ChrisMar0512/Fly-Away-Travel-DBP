# URL de conexión a la base de datos (por defecto usa H2 en memoria)
DB_URL=jdbc:h2:mem:traveldb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# Credenciales de la base de datos
DB_USERNAME=sa
DB_PASSWORD=

# JWT Configuración
# Debe ser una cadena base64 lo suficientemente larga para HS256
JWT_SECRET=tu_secreto_jwt_aqui_cambialo_en_produccion_por_seguridad
# Tiempo de expiración en milisegundos (ejemplo: 86400000 = 1 día)
JWT_EXPIRATION_MS=86400000
