{
  "info": {
    "name": "Fly Away Travel API",
    "description": "Colección de Postman para probar los endpoints de la API de Fly Away Travel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public (Sin Token)",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"testuser@example.com\",\r\n  \"firstName\": \"John\",\r\n  \"lastName\": \"Doe\",\r\n  \"password\": \"Pass1word!\"\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"testuser@example.com\",\r\n  \"password\": \"Pass1word!\"\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Create Flight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"flightNumber\": \"AA984\",\r\n  \"airlineName\": \"American Airlines\",\r\n  \"departureTime\": \"2026-12-01T10:00:00\",\r\n  \"arrivalTime\": \"2026-12-01T14:00:00\",\r\n  \"availableSeats\": 150\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/flights/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "create"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Protected (Con Token)",
      "item": [
        {
          "name": "Search Flights",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/search?flightNumber=AA&airlineName=American&startDate=2026-01-01T00:00:00&endDate=2026-12-31T23:59:59",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "search"
              ],
              "query": [
                {
                  "key": "flightNumber",
                  "value": "AA"
                },
                {
                  "key": "airlineName",
                  "value": "American"
                },
                {
                  "key": "startDate",
                  "value": "2026-01-01T00:00:00"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-31T23:59:59"
                }
              ]
            }
          }
        },
        {
          "name": "Book Flight",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"flightId\": 1\r\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/flights/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "book"
              ]
            }
          }
        },
        {
          "name": "Get Booking Details by Alias",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flight/book/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flight",
                "book",
                "1"
              ]
            }
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "1"
              ]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1"
              ]
            }
          }
        },
        {
          "name": "Get Flight by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin",
      "item": [
        {
          "name": "Cleanup Database",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cleanup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cleanup"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
